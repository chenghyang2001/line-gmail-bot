flowchart TD
    USER(["👤 使用者\n在 LINE 輸入\n「addwii 有什麼優惠」"])
    LINE_PLATFORM["☁️ LINE Platform\nPOST /line-webhook\nX-Line-Signature: HMAC-SHA256"]

    subgraph MAIN["main.py — FastAPI"]
        VERIFY["line_service.verify_signature()\nHMAC-SHA256 驗簽"]
        PARSE["json.loads(body)\n解析 webhook payload"]
        EXTRACT["line_service.extract_text_messages()\n取出純文字：「addwii 有什麼優惠」"]
        INTENT{"any(kw in text\nfor kw in INTENT_KEYWORDS)\n→ 命中「addwii」"}
        REPLY_NO["line_service.push_message()\n回覆：請輸入查詢關鍵字"]
        RETURN200["return JSONResponse\n{status: ok} 200"]
    end

    subgraph GMAIL["services/gmail_service.py"]
        GET_SVC["get_gmail_service()\n載入 token.json\n自動 refresh 過期 token"]
        SEARCH["search_emails()\nquery: subject:addwii\n健康 OR 活動 OR 優惠\nmax_results=5"]
        LATEST["取 emails[0]\n最新一封信"]
        HAS_PDF{"附件中\n有 PDF?"}
        DOWNLOAD["download_attachment()\n下載 PDF bytes"]
    end

    subgraph PDF["services/pdf_parser.py"]
        PDF_PARSE["extract_text_from_bytes()\npypdf 解析\n最多 5 頁 × 2000 字"]
    end

    subgraph CLAUDE["services/claude_service.py"]
        COMBINE["組合內容\n主旨 + body + PDF文字"]
        TRUNCATE["超過 6000 字截斷"]
        CLAUDE_API["claude-haiku-4-5-20251001\nmax_tokens=800\n繁體中文摘要 100-200 字"]
    end

    subgraph LINE_SVC["services/line_service.py"]
        PUSH["push_message()\nPOST api.line.me/v2/bot/message/push\n📧 最新活動摘要：..."]
    end

    USER -->|"LINE app 發訊"| LINE_PLATFORM
    LINE_PLATFORM -->|"webhook POST"| VERIFY
    VERIFY -->|"驗簽失敗 → 記錄 IP"| RETURN200
    VERIFY -->|"驗簽通過"| PARSE
    PARSE --> EXTRACT
    EXTRACT --> INTENT
    INTENT -->|"No — 無關鍵字"| REPLY_NO
    INTENT -->|"Yes — 有意圖"| GET_SVC
    REPLY_NO --> RETURN200

    GET_SVC --> SEARCH
    SEARCH -->|"無信件"| PUSH
    SEARCH --> LATEST
    LATEST --> HAS_PDF
    HAS_PDF -->|"Yes"| DOWNLOAD
    HAS_PDF -->|"No"| COMBINE
    DOWNLOAD --> PDF_PARSE
    PDF_PARSE --> COMBINE
    COMBINE --> TRUNCATE
    TRUNCATE --> CLAUDE_API
    CLAUDE_API --> PUSH
    PUSH -->|"LINE API 200"| RETURN200
    RETURN200 -->|"回覆 200 給 LINE Platform"| LINE_PLATFORM
    LINE_PLATFORM -->|"摘要推送到 LINE"| USER

    style USER fill:#06C755,color:#fff
    style LINE_PLATFORM fill:#06C755,color:#fff
    style MAIN fill:#EBF5FB,stroke:#2980B9
    style GMAIL fill:#FEF9E7,stroke:#F39C12
    style PDF fill:#FDEDEC,stroke:#E74C3C
    style CLAUDE fill:#F4ECF7,stroke:#8E44AD
    style LINE_SVC fill:#E8F8F5,stroke:#1ABC9C
    style INTENT fill:#FFF3CD,stroke:#F39C12
    style HAS_PDF fill:#FFF3CD,stroke:#F39C12
