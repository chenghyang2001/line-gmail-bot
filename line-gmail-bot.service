[Unit]
Description=LINE Gmail Bot FastAPI Service
After=network.target

[Service]
Type=simple
User=linebot
Group=linebot
WorkingDirectory=/opt/line-gmail-bot
EnvironmentFile=/opt/line-gmail-bot/.env
ExecStart=/opt/line-gmail-bot/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8091
Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=line-gmail-bot

[Install]
WantedBy=multi-user.target
